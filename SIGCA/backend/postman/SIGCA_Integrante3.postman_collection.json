        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Paciente\",\n  \"apellidos\": \"Postman\",\n  \"fechaNacimiento\": \"2000-01-15\",\n  \"sexo\": \"OTRO\",\n  \"telefono\": \"55550001\",\n  \"direccion\": \"Guatemala\",\n  \"observaciones\": \"Paciente de prueba Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/pacientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
