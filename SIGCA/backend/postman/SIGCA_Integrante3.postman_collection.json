    {
      "name": "01 - Estado API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API responde 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "status"
          ]
        },
        "description": "Comprueba que el backend está disponible."
      },
      "response": []
    },
    {
      "name": "02 - Iniciar sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test(\"Login responde 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", data.token);",
              "pm.test(\"Se guardó el token JWT\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Configura passwordAdmin como variable local antes de ejecutar. El test guarda el JWT en token."
      },
      "response": []
    },
    {
      "name": "03 - Consultar servicios activos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const list = Array.isArray(data) ? data : (data.servicios || data.data || []);",
              "pm.test(\"Servicios activos responde 200\", () => pm.response.to.have.status(200));",
              "const service = list.find(x => x.nombre === \"Servicio de prueba\") || list[0];",
              "if (service) {",
              "  pm.collectionVariables.set(\"servicioId\", service._id || service.id);",
              "  const cents = service.precioCentavos ?? Math.round(Number(service.precio) * 100);",
              "  if (Number.isFinite(Number(cents))) pm.collectionVariables.set(\"servicioPrecioCentavos\", String(cents));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servicios?estado=ACTIVO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "servicios"
          ],
          "query": [
            {
              "key": "estado",
              "value": "ACTIVO"
            }
          ]
        },
        "description": "Selecciona “Servicio de prueba” si existe y guarda su id y precio en variables."
      },
      "response": []
    },
