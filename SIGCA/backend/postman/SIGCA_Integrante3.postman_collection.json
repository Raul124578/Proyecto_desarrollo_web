              "const patient = data.paciente || data.data || data;",
              "const id = patient._id || patient.id;",
              "if (id) pm.collectionVariables.set(\"pacienteId\", id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
