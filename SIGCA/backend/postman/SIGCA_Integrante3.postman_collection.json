    {
      "name": "11 - Verificar cierre y diferencia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const list = Array.isArray(data) ? data : (data.cajas || data.data || []);",
              "const caja = list.find(x => (x._id || x.id) === pm.collectionVariables.get(\"cajaId\"));",
              "pm.test(\"Caja aparece cerrada\", () => pm.expect(caja && caja.estado).to.eql(\"CERRADA\"));",
              "if (caja) pm.test(\"Diferencia de caja es cero\", () => pm.expect(Number(caja.diferenciaCentavos)).to.eql(0));"
            ]
          }
        }
      ],
