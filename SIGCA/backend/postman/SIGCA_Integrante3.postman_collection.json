          ]
        },
        "description": "Crea un paciente adulto ficticio y guarda su id en pacienteId."
      },
      "response": []
    },
    {
      "name": "06 - Registrar cita de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Próximo lunes a las 10:00 en Guatemala (16:00 UTC); formato exigido por la API.const d = new Date();const daysUntilMonday = ((1 - d.getUTCDay() + 7) % 7) || 7;d.setUTCDate(d.getUTCDate() + daysUntilMonday);d.setUTCHours(16, 0, 0, 0);pm.collectionVariables.set(\"fechaInicio\", d.toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test(\"Cita creada\", () => pm.response.to.have.status(201));",
              "const cita = data.cita || data.data || data;",
              "const id = cita._id || cita.id;",
              "if (id) pm.collectionVariables.set(\"citaId\", id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": \"{{pacienteId}}\",\n  \"servicioId\": \"{{servicioId}}\",\n  \"profesionalId\": \"{{profesionalId}}\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"observaciones\": \"Cita de prueba Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/citas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas"
          ]
        },
        "description": "Ejecuta después de paciente, servicios y profesional. Programa el siguiente lunes a las 09:00 de Guatemala."
      },
      "response": []
    },
